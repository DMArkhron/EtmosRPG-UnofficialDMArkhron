<div class="etmos-item-detail">
  <header class="etmos-item-detail-header"><img src="{{item.img}}" alt=""/><div><small>ETMOS · {{kind}}</small>{{#if editable}}<input type="text" name="name" value="{{item.name}}" aria-label="Nome do item"/>{{else}}<h2>{{item.name}}</h2>{{/if}}</div></header>
  <div class="etmos-item-detail-meta">
    {{#if particle}}<span class="etmos-item-tag etmos-item-tag-{{system.categoria}}">{{particleCategory}}</span>{{#if editable}}<label>Código<input type="text" name="system.codigo" value="{{system.codigo}}"/></label><label>Categoria<select name="system.categoria"><option value="funcao" {{#if cat_funcao}}selected{{/if}} >Função</option><option value="objeto" {{#if cat_objeto}}selected{{/if}} >Objeto</option><option value="caracteristica" {{#if cat_caracteristica}}selected{{/if}} >Característica</option><option value="complemento" {{#if cat_complemento}}selected{{/if}} >Complemento</option></select></label>{{else}}<code>{{system.codigo}}</code>{{/if}}{{/if}}
    {{#if skill}}<span class="etmos-item-tag etmos-item-tag-habilidade">{{system.tipo}}</span>{{#if editable}}<label>Bônus<input type="number" name="system.bonus" value="{{system.bonus}}"/></label><label>Tipo<input type="text" name="system.tipo" value="{{system.tipo}}"/></label>{{else}}{{#if system.bonus}}<strong>Bônus: +{{system.bonus}}</strong>{{/if}}{{/if}}{{/if}}
    {{#if origin}}<span class="etmos-item-tag etmos-item-tag-origem">{{system.mundo}}</span>{{#if system.exclusivo}}<span class="etmos-item-tag">Exclusiva</span>{{/if}}{{#if editable}}<label>Procedência<input type="text" name="system.mundo" value="{{system.mundo}}"/></label><label>Exclusiva<input type="checkbox" name="system.exclusivo" {{#if system.exclusivo}}checked{{/if}}/></label><label>Escolha pessoal<input type="text" name="system.detalhe" value="{{system.detalhe}}"/></label>{{else}}{{#if system.detalhe}}<span>Escolha: {{system.detalhe}}</span>{{/if}}{{/if}}{{/if}}
  </div>
  <section class="etmos-item-detail-description"><h3>Descrição</h3>{{#if editable}}<textarea name="system.descricao" aria-label="Descrição">{{system.descricao}}</textarea>{{else}}<div class="etmos-item-description-text">{{#if description}}{{description}}{{else}}Sem descrição cadastrada.{{/if}}</div>{{/if}}</section>
</div>
